build/bin/
frontend/node_modules/
xpmulticrew-companion
xpmulticrew-companion.exe

# frontend/dist/ is generated by `wails build`/`npm run build`, but
# go:embed all:frontend/dist (main.go) needs the directory to exist with
# at least one file even before that first build runs (e.g. `go test`
# right after a fresh clone/checkout) - keep it non-empty via .gitkeep,
# ignore everything else the build writes into it.
frontend/dist/*
!frontend/dist/.gitkeep

# embedded_plugin/ is where the platform-specific plugin build output
# (build/XPMultiCrew/ from the CMake build) gets staged before `wails
# build`, so the companion binary can embed and install it - see
# plugin_install.go. Same reasoning as frontend/dist/ above.
embedded_plugin/*
!embedded_plugin/.gitkeep
